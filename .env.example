# Yuxi 环境变量示例（脱敏模板，可安全提交）
# 复制为 .env 使用，或直接运行 `bash scripts/deploy.sh` 自动生成。
# 真实 .env 已在 .gitignore 中排除，请勿提交真实密钥。

# ==================== 模型（三选一，按需启用） ====================
# 方式 A：wdtrip 网关（OpenAI 兼容，chat 用；embedding/rerank 需另配）
OPENAI_API_KEY=gw_-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
OPENAI_API_BASE=https://ai-gateway.wdtrip.com/v1
DEEPSEEK_API_KEY=

# 方式 B：DeepSeek 官方直连
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 方式 C：硅基流动（chat + embedding + rerank 三件套，知识库完整可用）
# SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx

# 联网搜索（可选：doubao | tavily）
WEB_SEARCH_PROVIDER=
DOUBAO_SEARCH_API_KEY=
TAVILY_API_KEY=

# ==================== 身份安全（必填，各 ≥32 字符且互不相同） ====================
YUXI_ENV=development
JWT_SECRET_KEY=请替换为-openssl-rand-hex-32-生成的值
API_KEY_DERIVATION_SECRET=请替换为另一个-openssl-rand-hex-32
YUXI_INSTANCE_ID=instance-xxxxxxxx

# ==================== 中间件凭据 ====================
POSTGRES_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
NEO4J_PASSWORD=

# ==================== 沙盒 ====================
SANDBOX_PROVISIONER_TOKEN=请替换为-openssl-rand-hex-32

# ==================== 可选：CORS / 超管 / 端口 ====================
# YUXI_CORS_ORIGINS=
# YUXI_SUPER_ADMIN_NAME=
# YUXI_SUPER_ADMIN_PASSWORD=
# YUXI_API_PORT=5050
# YUXI_WEB_PORT=5173
