{
  "name": "yuxi-desktop",
  "version": "0.1.0",
  "description": "Yuxi macOS 桌面客户端",
  "private": true,
  "main": "src/main/index.js",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.js",
    "start": "npm run build:renderer && electron .",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.js",
    "dist": "npm run build:renderer && electron-builder --publish never",
    "dist:release": "node scripts/release.js"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "playwright-core": "1.65.1"
  },
  "overrides": {
    "minimatch@>=7 <11": "11.0.1"
  }
}
